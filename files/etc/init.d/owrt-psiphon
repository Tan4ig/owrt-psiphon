#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

BIN="/opt/owrt-psiphon/warp-plus"

start_service() {
        [ -x "$BIN" ] || {
                logger -t owrt-psiphon "binary not installed: $BIN"
                return 1
        }

        . /lib/functions.sh
        config_load owrt-psiphon
        config_get country main country NL
        config_get bind main bind 192.168.1.1
        config_get port main port 8086
        config_get endpoint main endpoint ""
        config_get test_url main test_url https://ipinfo.io/country

        # Never start a second listener over an existing manually started tunnel.
        if netstat -lnt 2>/dev/null | grep -q ":${port}[[:space:]]"; then
                if [ ! -s /var/run/owrt-psiphon.pid ] || ! kill -0 "$(cat /var/run/owrt-psiphon.pid 2>/dev/null)" 2>/dev/null; then
                        logger -t owrt-psiphon "port ${port} is already occupied; refusing to interrupt the existing process"
                        return 1
                fi
        fi

        mkdir -p /opt/owrt-psiphon/cache
        procd_open_instance
        if [ -n "$endpoint" ]; then
                procd_set_param command "$BIN" -4 -e "$endpoint" --cfon --country "$country" -b "${bind}:${port}" --cache-dir /opt/owrt-psiphon/cache --test-url "$test_url" -v
        else
                procd_set_param command "$BIN" -4 --cfon --country "$country" -b "${bind}:${port}" --cache-dir /opt/owrt-psiphon/cache --test-url "$test_url" -v
        fi
        procd_set_param respawn 3600 5 0
        procd_set_param pidfile /var/run/owrt-psiphon.pid
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
}

service_triggers() {
        procd_add_reload_trigger owrt-psiphon
}
