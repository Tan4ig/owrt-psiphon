#!/bin/sh
# rpcd exec plugin for OWRTPsiphon
CTL=/usr/libexec/owrt-psiphon/owrt-psiphonctl
. /usr/share/libubox/jshn.sh

list_methods() {
        cat <<'JSON'
{
  "status": {},
  "start": {},
  "stop": {},
  "adopt": {},
  "set_country": { "country": "string" },
  "probe": {},
  "scan": {},
  "scan_status": {}
}
JSON
}

case "$1" in
        list)
                list_methods
                ;;
        call)
                method="$2"
                read -r input
                json_load "$input" 2>/dev/null || true
                case "$method" in
                        status|start|stop|adopt|probe|scan|scan_status)
                                exec "$CTL" "$method"
                                ;;
                        set_country)
                                json_get_var country country
                                exec "$CTL" set_country "$country"
                                ;;
                        *)
                                echo '{"ok":false,"message":"Unknown method"}'
                                exit 1
                                ;;
                esac
                ;;
esac
